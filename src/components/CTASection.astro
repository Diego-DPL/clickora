---
/**
 * Cierre de páginas interiores. Cada página de contenido debe terminar en una
 * acción concreta: el tráfico de búsqueda que no encuentra salida se pierde.
 */
import { BUSINESS } from '../data/business';

interface Props {
  title: string;
  highlight: string;
  text: string;
  whatsappMessage?: string;
}

const { title, highlight, text, whatsappMessage = 'Hola, quiero una propuesta para mi web' } = Astro.props;
const waHref = `${BUSINESS.whatsapp}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section class="bg-blue py-24 md:py-32 overflow-hidden">
  <div class="max-w-[1600px] mx-auto px-8 md:px-16 lg:px-28">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-12">
      <div>
        <h2 class="font-display italic font-black text-[clamp(2.2rem,_5vw,_4.5rem)] text-ivory leading-[0.95] mb-6 reveal">
          {title}<br>
          <span class="text-yellow">{highlight}</span>
        </h2>
        <p class="text-sm leading-relaxed max-w-md reveal" style="color: rgba(250,250,245,0.65); transition-delay:0.1s">
          {text}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 flex-shrink-0 reveal" style="transition-delay:0.2s">
        <a href={waHref} target="_blank" rel="noopener noreferrer" class="btn-outline-white">
          Escribir por WhatsApp
        </a>
        <a href="/#contacto" class="btn-outline-white">Ver formulario</a>
      </div>
    </div>
  </div>
</section>
