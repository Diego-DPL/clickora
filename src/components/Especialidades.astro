---
/**
 * Enlaces contextuales de la home a las páginas de sector y a la local.
 *
 * Antes esas páginas solo recibían enlaces desde el menú y el pie, que en todas
 * las páginas son los mismos y pesan poco. La home es la página con más
 * autoridad del sitio y no enlazaba a ninguna desde su contenido: este bloque
 * reparte esa autoridad con texto de enlace descriptivo, que es justo lo que
 * Google usa para entender de qué va la página de destino.
 */
const especialidades = [
  {
    href: '/paginas-web-para-psicologos/',
    title: 'Páginas web para psicólogos',
    text: 'Una página por motivo de consulta, contacto discreto y textos que ayudan a dar el primer paso.',
  },
  {
    href: '/paginas-web-para-fisioterapeutas/',
    title: 'Páginas web para fisioterapeutas',
    text: 'Páginas por servicio, reserva de cita sin fricción y textos escritos desde el dolor del paciente.',
  },
  {
    href: '/paginas-web-para-clinicas-esteticas/',
    title: 'Páginas web para clínicas estéticas',
    text: 'Una página por tratamiento, con precio, resultados reales y publicidad sanitaria bien planteada.',
  },
  {
    href: '/diseno-web-murcia/',
    title: 'Diseño web en Murcia',
    text: 'Para negocios de servicios de Murcia que necesitan que les encuentren y que les llamen.',
  },
];
---

<section class="bg-ivory py-24 md:py-32 overflow-hidden">
  <div class="max-w-[1600px] mx-auto px-8 md:px-16 lg:px-28">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14 md:mb-16">
      <div>
        <p class="label text-muted mb-4 reveal-fast">Especialidades</p>
        <h2 class="font-display italic font-black text-[clamp(2.5rem,_6vw,_5.5rem)] text-ink leading-[0.93] reveal" style="transition-delay:0.1s">
          Sabemos cómo<br>
          <span class="text-blue">funciona tu sector.</span>
        </h2>
      </div>
      <p class="text-muted text-sm max-w-xs leading-relaxed reveal-fast" style="transition-delay:0.2s">
        Cada sector capta clientes de una forma distinta. Estos son los que mejor conocemos.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-px bg-soft border-y border-soft">
      {especialidades.map((item, i) => (
        <a
          href={item.href}
          class="group bg-ivory p-8 md:p-10 hover:bg-ivory2 transition-colors duration-300 reveal"
          style={`transition-delay:${i * 0.08}s`}
        >
          <div class="flex items-start justify-between gap-6">
            <div>
              <h3 class="font-sans font-extrabold text-lg md:text-xl text-ink mb-3 leading-snug group-hover:text-blue transition-colors">
                {item.title}
              </h3>
              <p class="text-muted text-sm leading-relaxed max-w-md">{item.text}</p>
            </div>
            <svg
              class="w-5 h-5 text-soft group-hover:text-blue flex-shrink-0 mt-1 transition-all duration-300 group-hover:translate-x-1"
              fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
