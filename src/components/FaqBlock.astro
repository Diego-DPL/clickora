---
/**
 * Acordeón de preguntas frecuentes + su JSON-LD FAQPage.
 *
 * Van juntos a propósito: si el schema se declara aparte es cuestión de tiempo
 * que alguien edite una pregunta visible y se olvide del marcado, y Google
 * penaliza los datos estructurados que no coinciden con lo que ve el usuario.
 */
interface Props {
  faqs: { question: string; answer: string }[];
  titleTop: string;
  titleBottom: string;
  bg?: string;
}

const { faqs, titleTop, titleBottom, bg = 'bg-ivory' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<section class={`${bg} py-20 md:py-28 overflow-hidden`}>
  <div class="max-w-[1600px] mx-auto px-8 md:px-16 lg:px-28">
    <p class="label text-muted mb-4 reveal-fast">Preguntas frecuentes</p>
    <h2 class="font-display italic font-black text-[clamp(2rem,_5vw,_4.2rem)] text-ink leading-[0.95] mb-14 reveal">
      {titleTop}<br>
      <span class="text-blue">{titleBottom}</span>
    </h2>

    <div class="border-t border-soft">
      {faqs.map((faq, i) => (
        <details class="group border-b border-soft reveal" style={`transition-delay:${i * 0.06}s`}>
          <summary class="flex items-start justify-between gap-6 py-7 w-full list-none">
            <h3 class="font-sans font-semibold text-base md:text-lg text-ink leading-snug group-open:text-blue transition-colors duration-300 flex-1 pr-4">
              {faq.question}
            </h3>
            <span class="faq-icon w-8 h-8 border-2 border-soft group-open:border-blue flex items-center justify-center flex-shrink-0 mt-0.5 transition-colors duration-300">
              <svg class="w-3 h-3 text-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
              </svg>
            </span>
          </summary>
          <div class="pb-7 pr-4 md:pr-16">
            <p class="text-muted text-sm leading-relaxed max-w-3xl">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
