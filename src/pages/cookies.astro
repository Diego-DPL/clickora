---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    number: "01",
    title: "¿Qué son las cookies?",
    body: `Una cookie es un fichero que se descarga en tu ordenador al acceder a determinadas páginas web. Las cookies permiten a una página web, entre otras cosas, almacenar y recuperar información sobre los hábitos de navegación de un usuario o de su equipo y, dependiendo de la información que contengan y de la forma en que utilice su equipo, pueden utilizarse para reconocer al usuario.`,
  },
  {
    number: "02",
    title: "¿Qué tipos de cookies utiliza esta web?",
    types: [
      {
        name: "Cookies técnicas",
        desc: "Permiten al usuario la navegación a través de la página web y la utilización de las diferentes opciones o servicios que en ella existan.",
      },
      {
        name: "Cookies de análisis",
        desc: "Permiten el seguimiento y análisis del comportamiento de los usuarios. Utilizamos Google Analytics 4 con Consent Mode v2, lo que significa que solo se activan tras tu consentimiento expreso.",
      },
      {
        name: "Cookies de personalización",
        desc: "Permiten al usuario acceder al servicio con algunas características de carácter general predefinidas en función de una serie de criterios en el terminal del usuario.",
      },
    ],
  },
  {
    number: "03",
    title: "Gestión de cookies",
    body: `Puedes permitir, bloquear o eliminar las cookies instaladas en tu equipo desde la configuración de tu navegador:`,
    links: [
      ["Google Chrome", "https://support.google.com/chrome/answer/95647?hl=es"],
      ["Mozilla Firefox", "https://support.mozilla.org/es/kb/habilitar-y-deshabilitar-cookies-sitios-web-rastrear-preferencias"],
      ["Safari", "https://support.apple.com/es-es/guide/safari/sfri11471/mac"],
      ["Microsoft Edge", "https://support.microsoft.com/es-es/microsoft-edge/eliminar-las-cookies-en-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09"],
    ],
  },
];
---

<Layout
  title="Política de Cookies | Clickora"
  description="Política de Cookies de Clickora. Tipos de cookies que utilizamos, finalidad y cómo gestionarlas desde tu navegador."
>
  <Navbar />

  <main class="bg-ivory pt-32 md:pt-40 pb-24 md:pb-32">

    <!-- Editorial header -->
    <header class="max-w-[1400px] mx-auto px-8 md:px-16 lg:px-28 mb-20 md:mb-28">
      <p class="label text-muted mb-6">Documento legal · Última actualización 8 de junio de 2026</p>
      <h1 class="font-display italic font-black text-[clamp(3rem,_9vw,_7.5rem)] text-ink leading-[0.9]">
        Política de<br>
        <span class="text-blue">Cookies.</span>
      </h1>
    </header>

    <!-- Sections -->
    <div class="max-w-[1400px] mx-auto px-8 md:px-16 lg:px-28">
      <div class="grid md:grid-cols-12 gap-x-12 gap-y-20">

        {sections.map(section => (
          <article class="md:col-start-3 md:col-span-9 grid grid-cols-12 gap-x-6 border-t border-soft pt-10">

            <!-- Number -->
            <div class="col-span-12 md:col-span-2 mb-4 md:mb-0">
              <span class="font-display italic font-black text-3xl text-blue leading-none">
                {section.number}
              </span>
            </div>

            <!-- Content -->
            <div class="col-span-12 md:col-span-10">
              <h2 class="font-sans font-extrabold text-xl md:text-2xl text-ink mb-5 leading-tight">
                {section.title}
              </h2>

              {section.body && (
                <p class="text-ink/70 text-base leading-relaxed max-w-2xl">
                  {section.body}
                </p>
              )}

              {section.types && (
                <div class="mt-6 space-y-5 max-w-2xl">
                  {section.types.map(t => (
                    <div class="border-l-2 border-blue pl-5">
                      <h3 class="font-sans font-bold text-ink mb-1">{t.name}</h3>
                      <p class="text-ink/70 text-sm leading-relaxed">{t.desc}</p>
                    </div>
                  ))}
                </div>
              )}

              {section.links && (
                <ul class="mt-6 grid sm:grid-cols-2 gap-3 max-w-2xl">
                  {section.links.map(([name, url]) => (
                    <li>
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex items-center justify-between border border-soft hover:border-blue px-4 py-3 transition-colors duration-200"
                      >
                        <span class="text-ink text-sm font-semibold group-hover:text-blue transition-colors">{name}</span>
                        <span class="text-blue text-sm">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))}

        <!-- Back to home -->
        <div class="md:col-start-3 md:col-span-9 mt-12 pt-10 border-t border-soft">
          <a href="/" class="btn-outline">← Volver al inicio</a>
        </div>

      </div>
    </div>

  </main>

  <Footer />
</Layout>
