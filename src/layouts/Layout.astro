---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import { BUSINESS, PLANS, MAINTENANCE, SITE_URL, PUBLISH_FISCAL_IDENTITY } from '../data/business';

interface Props {
  title: string;
  description: string;
  /** Imagen social propia de la página. Por defecto, la genérica de marca. */
  image?: string;
  /** Para páginas que no deben indexarse (404, gracias, etc.). */
  noindex?: boolean;
  /** Migas de pan para el JSON-LD. Sin incluir "Inicio", se añade solo. */
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description, image = '/og-image.png', noindex = false, breadcrumbs } = Astro.props;

// Canonical por página. Con barra final para coincidir exactamente con las URLs
// que emite el sitemap: una canonical que no coincide con el sitemap manda
// señales contradictorias a Google.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, SITE_URL).href;
const socialImage = new URL(image, SITE_URL).href;

const GA_ID = 'G-2RNKJVV3SK';
// GSC: pega aquí el content del meta tag de Search Console y descomenta la línea del <head>.
// const GSC_VERIFICATION = 'PEGA_AQUI_EL_CONTENIDO_DEL_META_TAG';

// ── Datos estructurados ──────────────────────────────────────────────────────
// Generados desde src/data/business.ts para que no puedan contradecir a la web.
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE_URL}/#business`,
  name: BUSINESS.name,
  url: SITE_URL,
  logo: `${SITE_URL}/logo.png`,
  image: `${SITE_URL}/og-image.png`,
  telephone: BUSINESS.phone,
  email: BUSINESS.email,
  priceRange: BUSINESS.priceRange,
  description: BUSINESS.description,
  address: {
    '@type': 'PostalAddress',
    // La calle y el CP solo salen cuando haya alta e identidad fiscal publicable.
    ...(PUBLISH_FISCAL_IDENTITY
      ? { streetAddress: BUSINESS.street, postalCode: BUSINESS.postalCode }
      : {}),
    addressLocality: BUSINESS.city,
    addressRegion: BUSINESS.region,
    addressCountry: BUSINESS.country,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [...BUSINESS.hours.days],
      opens: BUSINESS.hours.opens,
      closes: BUSINESS.hours.closes,
    },
  ],
  geo: {
    '@type': 'GeoCoordinates',
    latitude: BUSINESS.geo.lat,
    longitude: BUSINESS.geo.lng,
  },
  areaServed: BUSINESS.areaServed.map((name) => ({ '@type': 'Place', name })),
  founder: { '@type': 'Person', name: BUSINESS.founder },
  knowsLanguage: ['es-ES'],
  sameAs: [...BUSINESS.sameAs],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de diseño y desarrollo web',
    itemListElement: [
      // El plan sin precio cerrado se declara como oferta sin importe: marcar un
      // precio inventado para un presupuesto a medida sería contradecir la web.
      ...PLANS.map((plan) => ({
        '@type': 'Offer',
        name: `Landing Page ${plan.name}`,
        description: plan.description,
        ...(plan.price ? { price: plan.price, priceCurrency: 'EUR' } : {}),
        url: `${SITE_URL}/#precios`,
        availability: 'https://schema.org/InStock',
      })),
      {
        '@type': 'Offer',
        name: MAINTENANCE.name,
        description: MAINTENANCE.description,
        price: MAINTENANCE.price,
        priceCurrency: 'EUR',
        url: `${SITE_URL}/#precios`,
        availability: 'https://schema.org/InStock',
      },
    ],
  },
};

// Migas de pan: ayudan a Google a entender la jerarquía del sitio y salen en
// los resultados sustituyendo a la URL cruda.
const breadcrumbSchema = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE_URL}/` },
        ...breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: crumb.name,
          item: new URL(crumb.path, SITE_URL).href,
        })),
      ],
    }
  : null;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: BUSINESS.name,
  inLanguage: 'es-ES',
  publisher: { '@id': `${SITE_URL}/#business` },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- GSC: descomenta cuando tengas el código de verificación -->
    <!-- <meta name="google-site-verification" content={GSC_VERIFICATION} /> -->

    <meta name="author" content={`${BUSINESS.name} - ${BUSINESS.founder}`} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Clickora — diseño y desarrollo de landing pages que convierten" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="theme-color" content="#0032FF" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>

    <!-- ═══════════════════════════════════════════════
         GOOGLE ANALYTICS 4 — Consent Mode v2 (GDPR)
         ══════════════════════════════════════════════ -->

    <!-- 1. Carga el script de gtag lo antes posible -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>

    <!-- 2. Inicializa con consent DENEGADO por defecto.
         Solo se activa cuando el usuario acepta las cookies. -->
    <script define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }

      // Consent Mode v2: todo denegado hasta que el usuario decida
      gtag('consent', 'default', {
        analytics_storage:   'denied',
        ad_storage:          'denied',
        ad_user_data:        'denied',
        ad_personalization:  'denied',
        wait_for_update:     500
      });

      gtag('js', new Date());
      gtag('config', GA_ID, {
        send_page_view: false,        // Lo enviamos solo tras consentimiento
        anonymize_ip:   true,
        cookie_flags:   'SameSite=None;Secure'
      });

      // Si el usuario ya aceptó en una visita anterior, activa inmediatamente
      if (localStorage.getItem('clickora_cookies') === 'accepted') {
        gtag('consent', 'update', {
          analytics_storage:  'granted',
          ad_storage:         'granted',
          ad_user_data:       'granted',
          ad_personalization: 'granted'
        });
        gtag('event', 'page_view');
      }
    </script>

    <!-- ═══════════════════════════════════════════════ -->

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
  </head>
  <body>
    <div id="cursor-dot"></div>
    <div id="cursor-ring"></div>

    <slot />
    <CookieBanner />

    <script>
      // Custom cursor
      if (window.matchMedia('(pointer: fine)').matches) {
        const dot  = document.getElementById('cursor-dot');
        const ring = document.getElementById('cursor-ring');

        if (dot && ring) {
          let mouseX = 0, mouseY = 0, ringX = 0, ringY = 0;

          document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            dot.style.transform = `translate(calc(${mouseX}px - 50%), calc(${mouseY}px - 50%))`;

            const els      = document.elementsFromPoint(mouseX, mouseY);
            const onBlue   = els.some(el => el.classList.contains('bg-blue'));
            const onYellow = !onBlue && els.some(el => el.classList.contains('bg-yellow'));
            dot.classList.toggle('on-blue',    onBlue);
            ring.classList.toggle('on-blue',   onBlue);
            dot.classList.toggle('on-yellow',  onYellow);
            ring.classList.toggle('on-yellow', onYellow);
          });

          function animateRing() {
            ringX += (mouseX - ringX) * 0.1;
            ringY += (mouseY - ringY) * 0.1;
            ring.style.transform = `translate(calc(${ringX}px - 50%), calc(${ringY}px - 50%))`;
            requestAnimationFrame(animateRing);
          }
          animateRing();

          document.querySelectorAll('a, button, [role="button"], input, textarea, summary').forEach(el => {
            el.addEventListener('mouseenter', () => { dot.classList.add('hovering'); ring.classList.add('hovering'); });
            el.addEventListener('mouseleave', () => { dot.classList.remove('hovering'); ring.classList.remove('hovering'); });
          });
        }
      }

      // Medición de leads en toda la web: cada clic a WhatsApp o al email es una
      // conversión. Sin esto solo se veían visitas, no contactos.
      document.querySelectorAll('a[href*="wa.me"], a[href^="mailto:"]').forEach((link) => {
        link.addEventListener('click', () => {
          const gtag = window.gtag;
          if (typeof gtag === 'function') {
            gtag('event', 'generate_lead', {
              method: link.getAttribute('href')?.startsWith('mailto:') ? 'email' : 'whatsapp',
              currency: 'EUR',
              value: 1,
            });
          }
        });
      });

      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in-view'); }),
        { threshold: 0.08, rootMargin: '0px 0px -50px 0px' }
      );
      document.querySelectorAll('.reveal, .reveal-fast').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
